rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{customerId} {
      // Must match VITE_ADMIN_EMAIL used by the desk app.
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email == 'baharali2027@gmail.com';
      }

      function memberFieldsValid() {
        return request.resource.data.keys().hasOnly([
            'name',
            'fatherName',
            'cnic',
            'phoneNumber',
            'photoUrl',
            'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.fatherName is string
          && request.resource.data.fatherName.size() >= 2
          && request.resource.data.fatherName.size() <= 80
          && request.resource.data.cnic is string
          && request.resource.data.cnic.matches('^\\d{13}$')
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^03\\d{9}$')
          && request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() > 100
          && request.resource.data.photoUrl.size() <= 900000;
      }

      allow read: if isAdmin();

      allow create: if isAdmin()
        && memberFieldsValid()
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && memberFieldsValid()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }
  }
}
